# Stage 1 — Build the blog site
FROM python:3.12-slim AS builder


WORKDIR /build

# Install blog dependencies
COPY requirements.shared.txt requirements.blog.txt ./

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.blog.txt

# Copy blog content and Zensical config
COPY blog/docs docs/
COPY blog/zensical.toml zensical.toml
COPY mkdocs_env.py mkdocs_env.py
COPY blog/main.py main.py

# Build the static site
RUN zensical build --strict

# Stage 2 — Serve with nginx
FROM nginx:1.31-alpine

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy built site from builder
COPY --from=builder /build/site /usr/share/nginx/html

# Copy custom nginx config
COPY nginx-blog.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=5m --timeout=5s --start-period=30s --retries=5 \
  CMD curl -f http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
